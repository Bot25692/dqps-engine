# Server-only Supabase credentials. Never use a NEXT_PUBLIC_ prefix for the key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATA_SOURCE=fixtures

# Optional server-only token for POST /api/run-analysis (x-demo-token header).
DEMO_ADMIN_TOKEN=

# Optional explanation provider
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
